                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"directory\": \"data/logs\",\n  \"pattern\": \"ERROR|FATAL\",\n  \"recursive\": false,\n  \"maxDurationSeconds\": 30,\n  \"concurrency\": 50,\n  \"maxResults\": 1000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
