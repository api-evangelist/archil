      "name": "Serverless Execution",
      "description": {
        "content": "Run commands on a disk without provisioning compute",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4fc666e0-97b7-493e-b72e-eeb9e54db5a0",
          "name": "Execute a command on a disk",
          "request": {
            "name": "Execute a command on a disk",
            "description": {
              "content": "Launches a container with the specified disk mounted, runs the given\ncommand to completion, and shuts down the container. Returns immediately\nwith the container info; poll the container endpoint for completion.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "disks",
                ":id",
                "exec"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Disk ID (format `dsk-{16 hex chars}`)"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
