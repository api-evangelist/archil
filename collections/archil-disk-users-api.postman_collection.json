          "name": "Add user to disk",
          "request": {
            "name": "Add user to disk",
            "description": {
              "content": "Adds an authorized user to a disk. Users can authenticate via:\n- **token**: A shared token with a nickname and 4-character suffix\n- **awssts**: AWS STS role assumption with an IAM principal ARN\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "disks",
                ":id",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Disk ID (format `dsk-{16 hex chars}`)"
                }
              ]
            },
